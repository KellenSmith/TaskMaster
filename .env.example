# Copy this file to .env and fill in real values. Never commit .env — it's gitignored.
# See docs/02-environment.md for the prose version of this list.

# ---------------------------------------------------------------------------
# Database (Prisma + PostgreSQL via Prisma Accelerate)
# ---------------------------------------------------------------------------

# Prisma Accelerate connection string used by the app at runtime (pooled,
# cached queries). Source: Prisma Data Platform (console.prisma.io) — create
# an Accelerate project connected to your Postgres instance and copy the
# generated "prisma://" URL. Falls back to a direct connection at runtime if
# this isn't an Accelerate URL.
ACCELERATE_DATABASE_URL=

# Direct Postgres connection string, used by the Prisma CLI for
# migrate/introspect and as a runtime fallback. Source: your Postgres
# provider (e.g. Vercel Postgres, Supabase, Neon, Railway, or a local
# `postgresql://user:password@localhost:5432/dbname`).
DIRECT_DATABASE_URL=

# ---------------------------------------------------------------------------
# Auth (Auth.js / next-auth)
# ---------------------------------------------------------------------------

# Secret used to sign/encrypt Auth.js JWTs and session tokens. Source:
# generate locally, e.g. `openssl rand -base64 32` (or `npx auth secret`).
# Must be kept secret and unique per environment.
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Email (magic-link sign-in + transactional mail via Nodemailer/SMTP)
# ---------------------------------------------------------------------------

# From-address used to send magic links and transactional emails. Must match
# the account authenticated via EMAIL_PASSWORD below. Source: your mailbox
# provider (e.g. a Gmail/Google Workspace address, or a transactional email
# provider's SMTP user).
EMAIL=

# SMTP password or app-specific password for the EMAIL account above.
# Source: your email provider's account/security settings (for Gmail, an
# "App Password" under Google Account > Security).
EMAIL_PASSWORD=

# SMTP server hostname. Source: your email provider's SMTP settings docs
# (e.g. smtp.gmail.com).
SMTP_HOST=

# SMTP port. Source: your email provider's SMTP settings docs (commonly 587
# for STARTTLS, 465 for implicit TLS).
SMTP_PORT=

# ---------------------------------------------------------------------------
# Cron (internal scheduled jobs, src/app/api/cron)
# ---------------------------------------------------------------------------

# Bearer token required to call the internal cron endpoint(s). Source:
# generate locally, e.g. `openssl rand -hex 32`; must match whatever secret
# your scheduler (Vercel Cron, GitHub Actions, etc.) sends as the
# Authorization header.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Payments (Swedbank Pay checkout)
# ---------------------------------------------------------------------------

# Swedbank Pay API base URL. Source: Swedbank Pay merchant/developer portal —
# use their test environment URL (e.g.
# https://api.externalintegration.payex.com) while developing, and the
# production URL for live payments.
SWEDBANK_BASE_URL=

# OAuth access token for the Swedbank Pay API. Source: Swedbank Pay
# merchant/developer portal, under your API credentials.
SWEDBANK_PAY_ACCESS_TOKEN=

# Your Swedbank Pay payee ID. Source: Swedbank Pay merchant/developer portal,
# under your merchant/store settings.
SWEDBANK_PAY_PAYEE_ID=

# ---------------------------------------------------------------------------
# File uploads (Vercel Blob)
# ---------------------------------------------------------------------------

# Public hostname of your Vercel Blob store, used to allowlist images in
# next.config.mjs. Source: Vercel dashboard > Storage > Blob store >
# copy the public hostname (e.g. abc123.public.blob.vercel-storage.com).
# Also requires a BLOB_READ_WRITE_TOKEN in real Vercel deployments, which
# Vercel injects automatically when a Blob store is linked to the project.
BLOB_HOSTNAME=

# ---------------------------------------------------------------------------
# Public / organization branding config (optional — all have code fallbacks)
# ---------------------------------------------------------------------------

# Organization display name shown in the UI, emails, and page metadata.
# Source: pick per deployment/customer environment. Falls back to
# "TaskMaster" if unset.
NEXT_PUBLIC_ORG_NAME=

# Meta description used for page/SEO metadata. Source: pick per
# deployment/customer environment.
NEXT_PUBLIC_ORG_DESCRIPTION=

# IANA timezone used for calendar/date display (dayjs). Source: pick per
# deployment/customer environment. Falls back to "Europe/Stockholm" if unset.
NEXT_PUBLIC_TIMEZONE=

# Comma-separated SEO keywords used in page metadata. Source: pick per
# deployment/customer environment, e.g. "volunteering,events,scheduling".
NEXT_PUBLIC_SEO_KEYWORDS=

# Fallback absolute base URL used for SEO metadata/sitemap/robots.txt when
# not running on Vercel (VERCEL_URL takes precedence when present). Source:
# your custom domain, e.g. https://example.com.
NEXT_PUBLIC_BASE_URL=

# Google Search Console verification code for the "google" meta tag.
# Source: Google Search Console > Settings > Ownership verification > HTML
# tag method > copy the "content" value.
GOOGLE_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Seeding (local/dev mock data — `pnpm prisma-seed`, src/prisma/seed.ts)
# ---------------------------------------------------------------------------
# The seed script WIPES the database configured via DIRECT_DATABASE_URL and
# inserts a fresh small dataset of mock data. It always requires
# SEED_CONFIRM_WIPE=true to actually run (see below) so it can't be triggered
# by accident against the wrong database.

# Must be exactly "true" to let the seed script wipe and reseed the database.
# Not set by default on purpose — this is a destructive operation.
SEED_CONFIRM_WIPE=

# Email for the single fixed admin account the seed script (re)creates after
# wiping, so you never get locked out of your own login after reseeding.
# Source: pick your own login email. Falls back to "admin@example.com" if unset.
SEED_ADMIN_EMAIL=

# First name for the seeded admin account above. Falls back to "Admin" if unset.
SEED_ADMIN_FIRST_NAME=

# Surname for the seeded admin account above. Falls back to "User" if unset.
SEED_ADMIN_SUR_NAME=

# Nickname for the seeded admin account above. Falls back to "admin" if unset.
SEED_ADMIN_NICKNAME=

# ---------------------------------------------------------------------------
# Provided automatically by the platform — do NOT set these locally
# ---------------------------------------------------------------------------
# NODE_ENV                        — set by Next.js/Node itself.
# VERCEL_URL                      — set by Vercel for preview/production deploys.
# VERCEL_PROJECT_PRODUCTION_URL   — set by Vercel for the production deployment.
