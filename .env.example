# Required
ACCELERATE_DATABASE_URL=prisma://accelerate.prisma-data.net/?api_key=your-accelerate-api-key
DIRECT_DATABASE_URL=postgresql://user:password@localhost:5432/taskmaster
AUTH_SECRET=replace-with-a-long-random-secret
EMAIL=you@example.com
EMAIL_PASSWORD=replace-with-smtp-password
SMTP_HOST=smtp.example.com
SMTP_PORT=587
CRON_SECRET=replace-with-cron-secret

# Payments (Swedbank Pay)
SWEDBANK_BASE_URL=https://api.externalintegration.payex.com
SWEDBANK_PAY_ACCESS_TOKEN=replace-with-oauth-token
SWEDBANK_PAY_PAYEE_ID=replace-with-payee-id

# File uploads (Vercel Blob)
BLOB_HOSTNAME=abc123.public.blob.vercel-storage.com

# Public config (optional)
NEXT_PUBLIC_ORG_NAME=Taskmaster
NEXT_PUBLIC_ORG_DESCRIPTION=Taskmaster organization platform
VERCEL_URL=my-app.vercel.app
