{
    "name": "task-master",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev --turbopack --experimental-https",
        "backup:db": "bash scripts/backup-db.sh",
        "backup:db:if-production": "if [ \"${VERCEL:-}\" = \"1\" ] && [ \"${VERCEL_ENV:-}\" = \"production\" ]; then pnpm backup:db; else echo 'Skipping DB backup (not a production Vercel deploy).'; fi",
        "build": "pnpm prisma-generate && pnpm prisma migrate deploy && next build",
        "analyze": "powershell -Command \"$env:ANALYZE='true'; next build\"",
        "start": "next start",
        "lint": "eslint .",
        "prisma-generate": "prisma generate",
        "prisma-migrate": "pnpm prisma migrate dev",
        "prisma-migrate-reset": "pnpm prisma migrate reset",
        "prisma-push": "pnpm prisma db push",
        "prisma-seed": "tsx prisma/seed.ts",
        "prisma-seed-users": "tsx prisma/seed-users.ts",
        "email": "email dev --dir=./src/app/lib/mail-service/mail-templates --port=3001",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest watch",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@auth/core": "0.41.3",
        "@auth/prisma-adapter": "^2.11.3",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/icons-material": "^9.0.1",
        "@mui/material": "^9.0.1",
        "@mui/x-data-grid": "^9.3.0",
        "@mui/x-date-pickers": "^9.3.0",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "@prisma/extension-accelerate": "^3.0.1",
        "@react-email/components": "^1.0.12",
        "@react-pdf/renderer": "^4.5.1",
        "@testing-library/user-event": "^14.6.1",
        "@tiptap/core": "^3.23.6",
        "@tiptap/extension-bold": "^3.23.6",
        "@tiptap/extension-bullet-list": "^3.23.6",
        "@tiptap/extension-color": "^3.23.6",
        "@tiptap/extension-document": "^3.23.6",
